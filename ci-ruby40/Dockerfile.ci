# Defaults to upstream so local builds work without authenticating to ghcr.io.
# CI overrides this with our mirrored copy, so builds do not depend on Docker
# Hub availability or rate limits.
ARG BASE_IMAGE=ruby:4.0-slim-trixie
# DL3006: the default above is tagged; hadolint just can't see through the ARG.
# hadolint ignore=DL3006
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source=https://github.com/greenblacked/github-base-images
LABEL org.opencontainers.image.description="Shared CI image: Ruby 4.0 on Debian Trixie slim"
LABEL org.opencontainers.image.licenses=MIT

ENV DEBIAN_FRONTEND=noninteractive \
    CI=true \
    BUNDLE_JOBS=4 \
    BUNDLE_RETRY=3

# DL3008: apt pins would go stale and break the weekly rebuild, which is the
# actual update mechanism here.
# The upgrade picks up Debian security fixes published since the upstream base
# was last rebuilt; the Trivy gate blocks fixable HIGH/CRITICAL vulns, so
# waiting for upstream to rebuild would block this image too.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        gzip \
        jq \
        openssh-client \
        tar \
        unzip \
        xz-utils \
        zstd \
    && rm -rf /var/lib/apt/lists/*

# No compiler toolchain. Gems with native extensions add build-essential in
# their own workflow -- same philosophy as browsers not being baked into
# ci-node22: project-specific build tooling stays with the project.

# Replace the json default gem Ruby 4.0 ships (2.18.0, CVE-2026-33210,
# CRITICAL), which the vulnerability gate blocks (docs/adr/0006). No Ruby 4.0
# release carries a fixed json yet: ext/json/lib/json/version.rb is still
# 2.18.0 through v4.0.7. json 2.19.2 fixed it; the latest 2.19.x is used.
#
# Details, each needed:
#   - Installed into Ruby's own gem directory, not GEM_HOME, so this stays a
#     runtime replacement and test.sh's "no gems baked in" still holds.
#   - The default gemspec (specifications/default/json-2.18.0.gemspec) is
#     KEPT. It is what tells RubyGems that `require "json"` belongs to a gem,
#     so the require activates the newest installed version, 2.19.x. Deleting
#     it was tried: RubyGems then loaded the bundled 2.18.0 code straight
#     from the stdlib directory -- the scanner went quiet while the vulnerable
#     code stayed in use. test.sh asserts the version that actually loads.
#   - Trivy still reports that leftover 2.18.0 gemspec, which is metadata
#     only; it has a path-scoped, expiring entry in .github/vuln-exceptions.json.
#   - json has a C extension, so a compiler is installed for the build and
#     purged in the same layer; test.sh asserts none is left behind.
# Drop this block, and the exception, once the ruby:4.0 image ships
# json >= 2.19.2.
ARG JSON_VERSION=2.19.9
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install --yes --no-install-recommends gcc libc6-dev make \
    && gem install --no-document \
        --install-dir "$(ruby -e 'print Gem.default_dir')" \
        json --version "${JSON_VERSION}" \
    && apt-get purge --yes --auto-remove gcc libc6-dev make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN ruby --version \
    && gem --version \
    && bundler --version \
    && git --version

# GitHub Actions supplies commands dynamically.
# Do not define ENTRYPOINT or CMD.
