# Defaults to upstream so local builds work without authenticating to ghcr.io.
# CI overrides this with our mirrored copy, so builds do not depend on Docker
# Hub availability or rate limits.
#
# NOTE: this image is deliberately NOT named for a Rust version, unlike the
# language images that track a release line. Rust has no LTS and no parallel
# supported branches: upstream patches exactly one version, the current stable,
# and fixes are never backported to an older minor. An image called
# `ci-rust185` therefore promises a choice that does not exist -- and guarantees
# it falls out of support six weeks later, which is exactly what happened: it
# sat on 1.85 while stable reached 1.97.
#
# Rust's own stability guarantee makes the rolling `1-bookworm` tag safe FOR
# COMPILATION: code that compiles on one 1.x compiles on later 1.x.
#
# It is NOT safe for linting, and that is the real cost of this choice. clippy
# gains lints every six weeks, so a consumer running `cargo clippy -- -D
# warnings` can go red without changing a line of their own code, and rustfmt
# can reflow on a new release. That trade is deliberate: the alternative was an
# image frozen twelve releases behind with no security fixes at all. Consumers
# who need lint stability should either not use `-D warnings` in CI, or pin the
# toolchain per project with a rust-toolchain.toml, which rustup honours inside
# this image and which holds clippy along with rustc. Consumers who genuinely need
# an exact toolchain pin it per project with a rust-toolchain.toml, which is
# the mechanism Rust provides for that and which this image respects.
ARG BASE_IMAGE=rust:1-bookworm
# DL3006: the default above is tagged; hadolint just can't see through the ARG.
# hadolint ignore=DL3006
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source=https://github.com/greenblacked/github-base-images
LABEL org.opencontainers.image.description="Shared CI image: current stable Rust on Debian Bookworm"
LABEL org.opencontainers.image.licenses=MIT

ENV DEBIAN_FRONTEND=noninteractive \
    CI=true \
    CARGO_TERM_COLOR=always

# The upstream rust image is non-slim (there is no slim variant with the
# toolchain) and already ships git, curl, and a C toolchain for linking; the
# rest of the shared tool set is added here so every ci-* image promises the
# same baseline.
# DL3008: apt pins would go stale and break the weekly rebuild, which is the
# actual update mechanism here.
# The upgrade picks up Debian security fixes published since the upstream base
# was last rebuilt; the Trivy gate blocks fixable HIGH/CRITICAL vulns, so
# waiting for upstream to rebuild would block this image too.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        gzip \
        jq \
        openssh-client \
        tar \
        unzip \
        xz-utils \
        zstd \
    && rm -rf /var/lib/apt/lists/*

# rustfmt and clippy are what CI actually runs (`cargo fmt --check`,
# `cargo clippy`), and they are NOT in the upstream image: it runs rustup-init
# with `--profile minimal`, which ships only rustc, rust-std, and cargo. So this
# is a hard requirement, not a defensive no-op -- without it the smoke tests
# fail and the image's documented promise is false.
#
# Trade-off: rustup fetches the components from static.rust-lang.org, making
# this the only build-time network dependency outside ci-tools. If that host is
# unreachable the build fails rather than silently shipping without them.
RUN rustup component add rustfmt clippy

WORKDIR /workspace

# Verify the components installed above at build time, not just in test.sh --
# a missing component should fail the build rather than the later smoke gate.
RUN rustc --version \
    && cargo --version \
    && cargo fmt --version \
    && cargo clippy --version \
    && git --version

# GitHub Actions supplies commands dynamically.
# Do not define ENTRYPOINT or CMD.
