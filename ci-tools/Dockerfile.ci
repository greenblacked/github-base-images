# Defaults to upstream so local builds work without authenticating to ghcr.io.
# CI overrides this with our mirrored copy, so builds do not depend on Docker
# Hub availability or rate limits.
ARG BASE_IMAGE=debian:bookworm-slim
# DL3006: the default above is tagged; hadolint just can't see through the ARG.
# hadolint ignore=DL3006
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source=https://github.com/greenblacked/github-base-images
LABEL org.opencontainers.image.description="Shared CI image: infra/deploy tooling (terraform, kubectl, aws, docker CLI) on Debian Bookworm slim"
LABEL org.opencontainers.image.licenses=MIT

ENV DEBIAN_FRONTEND=noninteractive \
    CI=true

# DL3008: apt pins would go stale and break the weekly rebuild, which is the
# actual update mechanism here.
# The upgrade picks up Debian security fixes published since the upstream base
# was last rebuilt; the Trivy gate blocks fixable HIGH/CRITICAL vulns, so
# waiting for upstream to rebuild would block this image too.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        gzip \
        jq \
        openssh-client \
        tar \
        unzip \
        xz-utils \
        zstd \
    && rm -rf /var/lib/apt/lists/*

# Infra tools are installed as pinned upstream release binaries, not apt --
# Debian's repos either lag far behind or do not carry them at all. Each pin is
# a build arg so a bump is a one-line change that the vulnerability scan and
# smoke tests then revalidate.
#
# Terraform and kubectl are additionally verified against the SHA-256 their
# vendor publishes alongside the release, in the same style as Composer in
# ci-php84 and gitleaks in security.yml. `curl -f` over TLS proves the transport
# was not tampered with; it does not prove the artifact is the one that was
# published. Checksums are per-architecture, so a version bump is a three-line
# change (version plus both sums) that CI revalidates.
#
# The Docker static tarball and the AWS CLI installer have no vendor checksum
# to verify against: download.docker.com returns 404 for `<tarball>.sha256`,
# and AWS ships only a detached GPG signature. Their sums below are therefore
# trust-on-first-use: scripts/bump-pins.sh downloads each artifact when it
# moves the version and records the sha256 of what it got -- for the AWS CLI
# only after AWS's signature verified against AWS's key, pinned by
# fingerprint in that script, so that first use is checked too. A TOFU sum
# cannot prove the first download was genuine; what it does is pin it, so a
# file substituted later fails every build, the daily rebuilds included,
# instead of being installed. The bump PR then waits seven days from the day
# it first carried that version before it may merge (docs/adr/0008,
# amendment of 2026-10-17). CONTRIBUTING.md records which sums are which.
#
# TARGETARCH is set by buildx (amd64 / arm64); each vendor spells the
# architecture differently, hence the per-tool mapping. Every mapping now fails
# loudly on an unknown value: the previous `[ x = arm64 ] && ... || ...` form
# silently fell through to x86_64 for any other input, which installs a
# wrong-arch binary that only surfaces as a confusing smoke-test failure.
#
# Every download carries --retry and --max-time. Without a deadline a hung CDN
# connection stalls until the job's 45-minute timeout and is reported as "build
# timed out" rather than naming the download that hung.
ARG TARGETARCH
ARG TERRAFORM_VERSION=1.16.6
ARG TERRAFORM_SHA256_AMD64=38034b38d03096399a7a1264a14561a8029b2b496fd1f169452656e53968f1b7
ARG TERRAFORM_SHA256_ARM64=a750b5a11038f165846b2658c40c88cd7070aa67a61bab431a14ba27928ea9ea
ARG KUBECTL_VERSION=1.37.1
ARG KUBECTL_SHA256_AMD64=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
ARG KUBECTL_SHA256_ARM64=ff749f4b78d9c4f1ec87307df9b50119ed819e2094aa9810cb9acffc3286c8c7
ARG AWSCLI_VERSION=2.38.1
ARG AWSCLI_SHA256_AMD64=b11ed416d91f4251da363a17706938eeaf0e520745754c104c0c1890dd8363c7
ARG AWSCLI_SHA256_ARM64=91360c0adb2ae508334ff657dce4787b598b443a11cf3dc58e08b74f12e16009
ARG DOCKER_VERSION=29.9.1
ARG DOCKER_SHA256_AMD64=c158ecc55adb3afb01bbd3539ed3b997d20c26dbdc418080506cc1bf5243ff57
ARG DOCKER_SHA256_ARM64=3e93cc6d1a686456a3b18eefdde26467a837a7a2b257af22e27cba1dbc1b2018

RUN case "${TARGETARCH}" in \
        amd64) sum="${TERRAFORM_SHA256_AMD64}" ;; \
        arm64) sum="${TERRAFORM_SHA256_ARM64}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 180 \
        -o /tmp/terraform.zip \
        "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_${TARGETARCH}.zip" \
    && echo "${sum}  /tmp/terraform.zip" > /tmp/terraform.sum \
    && sha256sum --check --strict /tmp/terraform.sum \
    && rm /tmp/terraform.sum \
    && unzip -o /tmp/terraform.zip -d /usr/local/bin terraform \
    && rm /tmp/terraform.zip

RUN case "${TARGETARCH}" in \
        amd64) sum="${KUBECTL_SHA256_AMD64}" ;; \
        arm64) sum="${KUBECTL_SHA256_ARM64}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 180 \
        -o /usr/local/bin/kubectl \
        "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
    && echo "${sum}  /usr/local/bin/kubectl" > /tmp/kubectl.sum \
    && sha256sum --check --strict /tmp/kubectl.sum \
    && rm /tmp/kubectl.sum \
    && chmod +x /usr/local/bin/kubectl

RUN case "${TARGETARCH}" in \
        amd64) awsarch=x86_64 sum="${AWSCLI_SHA256_AMD64}" ;; \
        arm64) awsarch=aarch64 sum="${AWSCLI_SHA256_ARM64}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 300 \
        -o /tmp/awscli.zip \
        "https://awscli.amazonaws.com/awscli-exe-linux-${awsarch}-${AWSCLI_VERSION}.zip" \
    && echo "${sum}  /tmp/awscli.zip" > /tmp/awscli.sum \
    && sha256sum --check --strict /tmp/awscli.sum \
    && rm /tmp/awscli.sum \
    && unzip -q /tmp/awscli.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/awscli.zip /tmp/aws

# Docker *client* only, no daemon. In Actions it talks to the host daemon via
# the mounted socket, or to a docker:dind service container.
RUN case "${TARGETARCH}" in \
        amd64) dockerarch=x86_64 sum="${DOCKER_SHA256_AMD64}" ;; \
        arm64) dockerarch=aarch64 sum="${DOCKER_SHA256_ARM64}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 180 \
        -o /tmp/docker.tgz \
        "https://download.docker.com/linux/static/stable/${dockerarch}/docker-${DOCKER_VERSION}.tgz" \
    && echo "${sum}  /tmp/docker.tgz" > /tmp/docker.sum \
    && sha256sum --check --strict /tmp/docker.sum \
    && rm /tmp/docker.sum \
    && tar -xzf /tmp/docker.tgz -C /tmp docker/docker \
    && mv /tmp/docker/docker /usr/local/bin/docker \
    && rm -rf /tmp/docker.tgz /tmp/docker

WORKDIR /workspace

RUN terraform version \
    && kubectl version --client \
    && aws --version \
    && docker --version \
    && git --version

# GitHub Actions supplies commands dynamically.
# Do not define ENTRYPOINT or CMD.
