# Defaults to upstream so local builds work without authenticating to ghcr.io.
# CI overrides this with our mirrored copy, so builds do not depend on Docker
# Hub availability or rate limits.
ARG BASE_IMAGE=debian:trixie-slim
# DL3006: the default above is tagged; hadolint just can't see through the ARG.
# hadolint ignore=DL3006
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source=https://github.com/greenblacked/github-base-images
LABEL org.opencontainers.image.description="Shared CI image: infra/deploy tooling (terraform, kubectl, aws, docker CLI) on Debian Trixie slim"
LABEL org.opencontainers.image.licenses=MIT

ENV DEBIAN_FRONTEND=noninteractive \
    CI=true

# gpg (the gpg binary alone, not the gnupg suite) is needed to check the
# fingerprint of Docker's ASCII-armoured signing key and convert it into a
# keyring; see the Docker CLI below.
#
# DL3008: apt pins would go stale and break the weekly rebuild, which is the
# actual update mechanism here.
# The upgrade picks up Debian security fixes published since the upstream base
# was last rebuilt; the Trivy gate blocks fixable HIGH/CRITICAL vulns, so
# waiting for upstream to rebuild would block this image too.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        gpg \
        gzip \
        jq \
        openssh-client \
        tar \
        unzip \
        xz-utils \
        zstd \
    && rm -rf /var/lib/apt/lists/*

# Infra tools are installed as pinned upstream release binaries, not Debian's
# apt -- Debian's repos either lag far behind or do not carry them at all (the
# Docker CLI comes from Docker's own signed apt repository). Each pin is
# a build arg so a bump is a one-line change that the vulnerability scan and
# smoke tests then revalidate.
#
# Terraform and kubectl are additionally verified against the SHA-256 their
# vendor publishes alongside the release, in the same style as Composer in
# ci-php84 and gitleaks in security.yml. `curl -f` over TLS proves the transport
# was not tampered with; it does not prove the artifact is the one that was
# published. Checksums are per-architecture, so a version bump is a three-line
# change (version plus both sums) that CI revalidates.
#
# The AWS CLI installer has no vendor checksum to verify against: AWS ships
# only a detached GPG signature. Its sums below are therefore
# trust-on-first-use: scripts/bump-pins.sh downloads each artifact when it
# moves the version and records the sha256 of what it got -- only after AWS's
# signature verified against AWS's key, pinned by fingerprint in that script,
# so that first use is checked too. A TOFU sum cannot prove the first download
# was genuine; what it does is pin it, so a file substituted later fails every
# build, the daily rebuilds included, instead of being installed. The bump PR
# then waits seven days from the day it first carried that version before it
# may merge (docs/adr/0008, amendment of 2026-10-17). CONTRIBUTING.md records
# which sums are which. The Docker CLI, the other TOFU download here until
# 2026-10-18, now comes from Docker's signed apt repository (below).
#
# TARGETARCH is set by buildx (amd64 / arm64); each vendor spells the
# architecture differently, hence the per-tool mapping. Every mapping now fails
# loudly on an unknown value: the previous `[ x = arm64 ] && ... || ...` form
# silently fell through to x86_64 for any other input, which installs a
# wrong-arch binary that only surfaces as a confusing smoke-test failure.
#
# Every download carries --retry and --max-time. Without a deadline a hung CDN
# connection stalls until the job's 45-minute timeout and is reported as "build
# timed out" rather than naming the download that hung.
ARG TARGETARCH
ARG TERRAFORM_VERSION=1.16.6
ARG TERRAFORM_SHA256_AMD64=38034b38d03096399a7a1264a14561a8029b2b496fd1f169452656e53968f1b7
ARG TERRAFORM_SHA256_ARM64=a750b5a11038f165846b2658c40c88cd7070aa67a61bab431a14ba27928ea9ea
ARG KUBECTL_VERSION=1.37.1
ARG KUBECTL_SHA256_AMD64=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
ARG KUBECTL_SHA256_ARM64=ff749f4b78d9c4f1ec87307df9b50119ed819e2094aa9810cb9acffc3286c8c7
ARG AWSCLI_VERSION=2.38.2
ARG AWSCLI_SHA256_AMD64=16a4d39d60b631d884f1260fd7755b72daef15baf6cac21131c6c71676164b37
ARG AWSCLI_SHA256_ARM64=ff75a24de7f5a6908dbe2f9ff88253f31e1d67b05595bb460516396daed5d1ff

RUN case "${TARGETARCH}" in \
        amd64) sum="${TERRAFORM_SHA256_AMD64}" ;; \
        arm64) sum="${TERRAFORM_SHA256_ARM64}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 180 \
        -o /tmp/terraform.zip \
        "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_${TARGETARCH}.zip" \
    && echo "${sum}  /tmp/terraform.zip" > /tmp/terraform.sum \
    && sha256sum --check --strict /tmp/terraform.sum \
    && rm /tmp/terraform.sum \
    && unzip -o /tmp/terraform.zip -d /usr/local/bin terraform \
    && rm /tmp/terraform.zip

RUN case "${TARGETARCH}" in \
        amd64) sum="${KUBECTL_SHA256_AMD64}" ;; \
        arm64) sum="${KUBECTL_SHA256_ARM64}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 180 \
        -o /usr/local/bin/kubectl \
        "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
    && echo "${sum}  /usr/local/bin/kubectl" > /tmp/kubectl.sum \
    && sha256sum --check --strict /tmp/kubectl.sum \
    && rm /tmp/kubectl.sum \
    && chmod +x /usr/local/bin/kubectl

RUN case "${TARGETARCH}" in \
        amd64) awsarch=x86_64 sum="${AWSCLI_SHA256_AMD64}" ;; \
        arm64) awsarch=aarch64 sum="${AWSCLI_SHA256_ARM64}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 300 \
        -o /tmp/awscli.zip \
        "https://awscli.amazonaws.com/awscli-exe-linux-${awsarch}-${AWSCLI_VERSION}.zip" \
    && echo "${sum}  /tmp/awscli.zip" > /tmp/awscli.sum \
    && sha256sum --check --strict /tmp/awscli.sum \
    && rm /tmp/awscli.sum \
    && unzip -q /tmp/awscli.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/awscli.zip /tmp/aws

# Docker *client* only, no daemon. In Actions it talks to the host daemon via
# the mounted socket, or to a docker:dind service container. Only the CLI:
# this image has never shipped the buildx or compose plugins, so the
# package's Recommends of both stay out (--no-install-recommends).
#
# It comes from Docker's own apt repository, the way the Azure CLI does in
# ci-cloud: InRelease is GPG-signed and apt checks that signature against this
# keyring (signed-by), then checks Packages against the hash InRelease lists
# for it, and the .deb against the hash Packages lists. Every byte installed
# so chains to a vendor signature. The static tarball this replaced was pinned
# only by a trust-on-first-use sha256 of our own download: Docker publishes no
# checksum or signature for it.
#
# The key is pinned the way Microsoft's is there: the file must hold exactly
# one primary key, Docker's "Docker Release (CE deb)", with this fingerprint.
# Docker signs with a subkey (D3306A018370199E527AE7997EA0A9C3F273FCD8); the
# fingerprint pinned is the primary's, which gpgv's VALIDSIG names as well. A
# swapped file, or a second key appended to it, fails the build instead of
# becoming a key apt trusts for this repository. ci-tools/test.sh checks the
# installed keyring the same way. gpg runs in a throwaway GNUPGHOME, so the
# image keeps no gpg state. scripts/bump-pins.sh checks InRelease against the
# same key, committed as scripts/keys/docker.asc.
#
# Unlike azure-cli, the version is pinned: one ARG holding the repository's
# full version string (epoch, upstream version, Debian revision), which
# scripts/bump-pins.sh rewrites from the signed index. Docker's repository
# keeps every release, so this pin does not go stale the way a Debian package
# pin would, and the CLI moves only through a bump PR, like every other tool
# here.
#
# The package installs /usr/bin/docker; the link keeps /usr/local/bin/docker,
# where the static binary lived, working for anything that names that path.
ARG DOCKER_KEY_FINGERPRINT=9DC858229FC7DD38854AE2D88D81803C0EBFCD88
ARG DOCKER_CLI_VERSION=5:29.9.2-1~debian.13~trixie
RUN case "$(dpkg --print-architecture)" in \
        amd64|arm64) ;; \
        *) echo "unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac \
    && GNUPGHOME="$(mktemp -d)" \
    && export GNUPGHOME \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 120 \
        -o /tmp/docker.asc https://download.docker.com/linux/debian/gpg \
    && gpg --batch --show-keys --with-colons /tmp/docker.asc > /tmp/docker.keys \
    && fprs="$(awk -F: '$1 == "pub" { p = 1; next } p && $1 == "fpr" { print $10; p = 0 }' /tmp/docker.keys)" \
    && if [ "${fprs}" != "${DOCKER_KEY_FINGERPRINT}" ]; then \
        echo "download.docker.com served key(s) '${fprs}', expected exactly ${DOCKER_KEY_FINGERPRINT}" >&2; exit 1; \
    fi \
    && gpg --batch --dearmor -o /usr/share/keyrings/docker.gpg /tmp/docker.asc \
    && rm -rf /tmp/docker.asc /tmp/docker.keys "${GNUPGHOME}" \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker.gpg] https://download.docker.com/linux/debian trixie stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install --yes --no-install-recommends "docker-ce-cli=${DOCKER_CLI_VERSION}" \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/docker /usr/local/bin/docker

WORKDIR /workspace

RUN terraform version \
    && kubectl version --client \
    && aws --version \
    && docker --version \
    && git --version

# GitHub Actions supplies commands dynamically.
# Do not define ENTRYPOINT or CMD.
