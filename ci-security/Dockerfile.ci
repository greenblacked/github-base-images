# Defaults to upstream so local builds work without authenticating to ghcr.io.
# CI overrides this with our mirrored copy, so builds do not depend on Docker
# Hub availability or rate limits.
ARG BASE_IMAGE=debian:bookworm-slim
# DL3006: the default above is tagged; hadolint just can't see through the ARG.
# hadolint ignore=DL3006
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source=https://github.com/greenblacked/github-base-images
LABEL org.opencontainers.image.description="Shared CI image: supply-chain scanning toolbox (trivy, syft, grype, cosign, gitleaks) on Debian Bookworm slim"
LABEL org.opencontainers.image.licenses=MIT

ENV DEBIAN_FRONTEND=noninteractive \
    CI=true

# DL3008: apt pins would go stale and break the weekly rebuild, which is the
# actual update mechanism here.
# The upgrade picks up Debian security fixes published since the upstream base
# was last rebuilt; the Trivy gate blocks fixable HIGH/CRITICAL vulns, so
# waiting for upstream to rebuild would block this image too.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        gzip \
        jq \
        openssh-client \
        tar \
        unzip \
        xz-utils \
        zstd \
    && rm -rf /var/lib/apt/lists/*

# Every tool here is a pinned release binary verified against the SHA-256 its
# vendor publishes -- all five projects ship a checksums file with their
# releases, so unlike ci-tools there is no unverified download in this image.
# That matters more here than anywhere else: an image whose whole purpose is
# telling you what is trustworthy has no business installing binaries it did
# not check.
#
# Checksums are per-architecture, so a bump is a three-line change (version
# plus both sums) which CI revalidates. Every download carries --retry and
# --max-time so a hung CDN names itself instead of running out the job clock.
#
# Deliberately NOT included: a vulnerability database. trivy and grype both
# fetch theirs at first run and cache it; baking a DB in would ship a snapshot
# that is stale the moment the image is published, and the staleness would be
# invisible to the consumer.
ARG TARGETARCH

ARG TRIVY_VERSION=0.74.0
ARG TRIVY_SHA256_AMD64=2ae6fe3ee734b7fdf11335663e18c75ea12dccc76062f09f164a3b0f8be4371a
ARG TRIVY_SHA256_ARM64=b94ce1976bbf3c15b514b605ee88be7c6d94a29be2302847ff01cb794d47aad5
RUN case "${TARGETARCH}" in \
        amd64) sum="${TRIVY_SHA256_AMD64}"; asset="Linux-64bit" ;; \
        arm64) sum="${TRIVY_SHA256_ARM64}"; asset="Linux-ARM64" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 180 -o /tmp/trivy.tgz \
        "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_${asset}.tar.gz" \
    && echo "${sum}  /tmp/trivy.tgz" > /tmp/trivy.sum \
    && sha256sum --check --strict /tmp/trivy.sum \
    && tar -xzf /tmp/trivy.tgz -C /usr/local/bin trivy \
    && rm /tmp/trivy.tgz /tmp/trivy.sum

ARG SYFT_VERSION=1.51.0
ARG SYFT_SHA256_AMD64=2a2e837a2c8d59ec9af5472ee22d3b04ee463c4e44476ecf993fd1e5ab6ebc7f
ARG SYFT_SHA256_ARM64=6c0466811541ea03add5213a60a1562f0851e4c0b0ecfdee1a694a9455285900
RUN case "${TARGETARCH}" in \
        amd64) sum="${SYFT_SHA256_AMD64}" ;; \
        arm64) sum="${SYFT_SHA256_ARM64}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 180 -o /tmp/syft.tgz \
        "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_linux_${TARGETARCH}.tar.gz" \
    && echo "${sum}  /tmp/syft.tgz" > /tmp/syft.sum \
    && sha256sum --check --strict /tmp/syft.sum \
    && tar -xzf /tmp/syft.tgz -C /usr/local/bin syft \
    && rm /tmp/syft.tgz /tmp/syft.sum

ARG GRYPE_VERSION=0.117.0
ARG GRYPE_SHA256_AMD64=38525dab1e06f162ebaa02f94d82d1f807076b011a44180cf2777edf1a7b9c26
ARG GRYPE_SHA256_ARM64=935f628bdf9331ffdd946931ea5fdb50045d3970ba52670cbeb44a88f127291b
RUN case "${TARGETARCH}" in \
        amd64) sum="${GRYPE_SHA256_AMD64}" ;; \
        arm64) sum="${GRYPE_SHA256_ARM64}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 180 -o /tmp/grype.tgz \
        "https://github.com/anchore/grype/releases/download/v${GRYPE_VERSION}/grype_${GRYPE_VERSION}_linux_${TARGETARCH}.tar.gz" \
    && echo "${sum}  /tmp/grype.tgz" > /tmp/grype.sum \
    && sha256sum --check --strict /tmp/grype.sum \
    && tar -xzf /tmp/grype.tgz -C /usr/local/bin grype \
    && rm /tmp/grype.tgz /tmp/grype.sum

# cosign ships a bare binary rather than a tarball, so the checksum is taken
# over the installed file directly.
ARG COSIGN_VERSION=3.1.3
ARG COSIGN_SHA256_AMD64=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71
ARG COSIGN_SHA256_ARM64=c5d324e091826b0d7a78eb16fef316450b4eb9aaec045611c08ba06f5e73220a
RUN case "${TARGETARCH}" in \
        amd64) sum="${COSIGN_SHA256_AMD64}" ;; \
        arm64) sum="${COSIGN_SHA256_ARM64}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 180 -o /usr/local/bin/cosign \
        "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-${TARGETARCH}" \
    && echo "${sum}  /usr/local/bin/cosign" > /tmp/cosign.sum \
    && sha256sum --check --strict /tmp/cosign.sum \
    && rm /tmp/cosign.sum \
    && chmod +x /usr/local/bin/cosign

# Kept at the same version security.yml pins for the repository's own history
# scan, so the tool a consumer runs locally matches the one that gates here.
# gitleaks spells x86_64 "x64", unlike the other four.
ARG GITLEAKS_VERSION=8.30.1
ARG GITLEAKS_SHA256_AMD64=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
ARG GITLEAKS_SHA256_ARM64=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
RUN case "${TARGETARCH}" in \
        amd64) sum="${GITLEAKS_SHA256_AMD64}"; asset="x64" ;; \
        arm64) sum="${GITLEAKS_SHA256_ARM64}"; asset="arm64" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 180 -o /tmp/gitleaks.tgz \
        "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${asset}.tar.gz" \
    && echo "${sum}  /tmp/gitleaks.tgz" > /tmp/gitleaks.sum \
    && sha256sum --check --strict /tmp/gitleaks.sum \
    && tar -xzf /tmp/gitleaks.tgz -C /usr/local/bin gitleaks \
    && rm /tmp/gitleaks.tgz /tmp/gitleaks.sum

WORKDIR /workspace

RUN trivy --version \
    && syft version \
    && grype version \
    && cosign version \
    && gitleaks version \
    && git --version

# GitHub Actions supplies commands dynamically.
# Do not define ENTRYPOINT or CMD.
