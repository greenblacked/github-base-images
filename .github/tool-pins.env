# Tool pins the workflows read at run time: the release binaries a workflow
# step downloads and checksum-verifies itself, rather than through an image.
#
# Maintained by the pin-bump bot (.github/workflows/pin-bump.yml, which runs
# scripts/bump-pins.sh): it moves each version together with its checksum.
# They live here and not in the workflows' own `env:` blocks because the bot
# pushes with the workflow token, and GitHub refuses any push made with that
# token that changes a file under .github/workflows/. `bump-pins.sh --check`
# fails for a bump-managed pin under .github/workflows/, so none can move back.
#
# Plain `KEY=value` lines, one per key, no quotes and nothing after the value.
# This is data, never sourced: each step that uses a pin greps for exactly one
# `KEY=<value>` line, checks the value's shape (a dotted version, or 64 hex
# digits for a sha256) and fails when either is missing or malformed.
# scripts/check-pins.sh reads the versions for the drift report.

# gitleaks, for the git history scan in security.yml (the ci-security image's
# copy is pinned in its Dockerfile; bump-pins.sh moves both together).
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb

# osv-scanner, for the OSV report in build-image.yml (linux amd64 binary).
OSV_SCANNER_VERSION=2.6.0
OSV_SCANNER_SHA256=ca69b3d3cd08f889a49dc0a383122f71cc528b83803671df5fd874d97485b108
