# Defaults to upstream so local builds work without authenticating to ghcr.io.
# CI overrides this with our mirrored copy, so builds do not depend on Docker
# Hub availability or rate limits.
#
# NOTE: like ci-java21, this is not built on Debian Bookworm. Temurin publishes
# no bookworm tag -- only Ubuntu (jammy/noble) and Alpine -- so pinning `-noble`
# keeps the base an official Temurin build. Debian bookworm does ship a JDK 17,
# so unlike ci-java21 that would technically work here; it is still not used,
# because then the two Java images would be built two different ways and drift
# apart. Its version line is `noble-v1`, not `bookworm-v1`.
ARG BASE_IMAGE=eclipse-temurin:17-jdk-noble
# DL3006: the default above is tagged; hadolint just can't see through the ARG.
# hadolint ignore=DL3006
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source=https://github.com/greenblacked/github-base-images
LABEL org.opencontainers.image.description="Shared CI image: Temurin JDK 17 on Ubuntu Noble"
LABEL org.opencontainers.image.licenses=MIT

ENV DEBIAN_FRONTEND=noninteractive \
    CI=true

# DL3008: apt pins would go stale and break the weekly rebuild, which is the
# actual update mechanism here.
# The upgrade picks up distribution security fixes published since the upstream
# base was last rebuilt; the Trivy gate blocks fixable HIGH/CRITICAL vulns, so
# waiting for upstream to rebuild would block this image too.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        gzip \
        jq \
        openssh-client \
        tar \
        unzip \
        xz-utils \
        zstd \
    && rm -rf /var/lib/apt/lists/*

# No Maven and no Gradle. Both ship a wrapper (mvnw/gradlew) that projects
# commit and that pins the exact version the project builds with -- baking a
# second copy here would either be ignored or fight the wrapper. Same reasoning
# as browsers not being baked into ci-node22.

WORKDIR /workspace

RUN java --version \
    && javac --version \
    && jar --version \
    && git --version

# GitHub Actions supplies commands dynamically.
# Do not define ENTRYPOINT or CMD.
