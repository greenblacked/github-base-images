# Defaults to upstream so local builds work without authenticating to ghcr.io.
# CI overrides this with our mirrored copy, so builds do not depend on Docker
# Hub availability or rate limits.
#
# NOTE: this is the one base that does not come from Docker Hub. Microsoft
# publishes .NET only to mcr.microsoft.com, which has no rate limits and needs
# no authentication -- the mirror still exists so builds depend on one registry
# rather than two, and so we control the digest we build from.
ARG BASE_IMAGE=mcr.microsoft.com/dotnet/sdk:9.0-bookworm-slim
# DL3006: the default above is tagged; hadolint just can't see through the ARG.
# hadolint ignore=DL3006
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source=https://github.com/greenblacked/github-base-images
LABEL org.opencontainers.image.description="Shared CI image: .NET SDK 9.0 on Debian Bookworm slim"
LABEL org.opencontainers.image.licenses=MIT

ENV DEBIAN_FRONTEND=noninteractive \
    CI=true \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

# DL3008: apt pins would go stale and break the weekly rebuild, which is the
# actual update mechanism here.
# The upgrade picks up Debian security fixes published since the upstream base
# was last rebuilt; the Trivy gate blocks fixable HIGH/CRITICAL vulns, so
# waiting for upstream to rebuild would block this image too.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        gzip \
        jq \
        openssh-client \
        tar \
        unzip \
        xz-utils \
        zstd \
    && rm -rf /var/lib/apt/lists/*

# No global tools (dotnet-format, reportgenerator, ...). Those are pinned per
# project in a .config/dotnet-tools.json manifest and restored by the project's
# own workflow, so baking a second copy here would either be ignored or fight
# the manifest.

WORKDIR /workspace

RUN dotnet --version \
    && dotnet --list-sdks \
    && git --version

# GitHub Actions supplies commands dynamically.
# Do not define ENTRYPOINT or CMD.
