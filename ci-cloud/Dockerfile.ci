# Defaults to upstream so local builds work without authenticating to ghcr.io.
# CI overrides this with our mirrored copy, so builds do not depend on Docker
# Hub availability or rate limits.
ARG BASE_IMAGE=debian:bookworm-slim
# DL3006: the default above is tagged; hadolint just can't see through the ARG.
# hadolint ignore=DL3006
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source=https://github.com/greenblacked/github-base-images
LABEL org.opencontainers.image.description="Shared CI image: GCP and Azure deploy tooling (gcloud, az, kubectl) on Debian Bookworm slim"
LABEL org.opencontainers.image.licenses=MIT

ENV DEBIAN_FRONTEND=noninteractive \
    CI=true \
    CLOUDSDK_CORE_DISABLE_PROMPTS=1 \
    CLOUDSDK_PYTHON=/usr/bin/python3 \
    PATH=/opt/google-cloud-sdk/bin:$PATH

# Companion to ci-tools, which carries the AWS CLI. The split is by cloud
# rather than by tool because most repositories deploy to exactly one of them,
# and a single image carrying all three CLIs would make every job pay for two
# it does not use -- these SDKs are large.
#
# python3 is not optional here: the gcloud CLI is a Python application and the
# plain linux tarball expects a system interpreter. The x86_64 tarball also
# ships its own Python under platform/bundledpythonunix; CLOUDSDK_PYTHON points
# gcloud at the system one, so that copy is never used and is deleted below.
# Kept, it carried its own cryptography 46.0.7 (CVE-2026-69247, CVE-2026-69249,
# GHSA-537c-gmf6-5ccf) into the image for the vulnerability gate to fail on,
# for no benefit. The arm64 tarball has no bundled Python at all, so both
# architectures now run gcloud the same way. gnupg is needed to check the
# fingerprint of Microsoft's ASCII-armoured signing key and convert it into a
# keyring.
#
# DL3008: apt pins would go stale and break the weekly rebuild, which is the
# actual update mechanism here.
# The upgrade picks up Debian security fixes published since the upstream base
# was last rebuilt; the Trivy gate blocks fixable HIGH/CRITICAL vulns, so
# waiting for upstream to rebuild would block this image too.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        gnupg \
        gzip \
        jq \
        openssh-client \
        python3 \
        tar \
        unzip \
        xz-utils \
        zstd \
    && rm -rf /var/lib/apt/lists/*

# The Azure CLI comes from Microsoft's own apt repository, GPG-signed and
# pinned to this keyring via signed-by. That is a stronger guarantee than the
# checksum pattern used elsewhere in this repo -- the signature chains to a key
# we install deliberately, rather than attesting to one specific file -- and it
# is why no version ARG appears here: the repository is the update mechanism,
# exactly as apt is for every other package in these images.
#
# That guarantee is only as good as the key, and the key arrives over the same
# HTTPS connection as everything else. So it is pinned too: the file must hold
# exactly one key, Microsoft's "Microsoft (Release signing)" key, whose
# fingerprint Microsoft documents for packages.microsoft.com
# (learn.microsoft.com, "Linux Software Repository for Microsoft Products").
# Any other key -- a swapped file, a second key appended to it -- fails the
# build instead of becoming a key apt trusts for azure-cli. ci-cloud/test.sh
# checks the installed keyring the same way. gpg runs in a throwaway
# GNUPGHOME, so the image keeps no gpg state.
#
# DL3008: see above. Version pinning azure-cli would freeze it against a
# repository that only carries recent versions, breaking the weekly rebuild.
ARG MICROSOFT_KEY_FINGERPRINT=BC528686B50D79E339D3721CEB3E94ADBE1229CF
# hadolint ignore=DL3008
RUN GNUPGHOME="$(mktemp -d)" \
    && export GNUPGHOME \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 120 \
        -o /tmp/microsoft.asc https://packages.microsoft.com/keys/microsoft.asc \
    && gpg --batch --show-keys --with-colons /tmp/microsoft.asc > /tmp/microsoft.keys \
    && fprs="$(awk -F: '$1 == "fpr" { print $10 }' /tmp/microsoft.keys)" \
    && if [ "${fprs}" != "${MICROSOFT_KEY_FINGERPRINT}" ]; then \
        echo "packages.microsoft.com served key(s) '${fprs}', expected exactly ${MICROSOFT_KEY_FINGERPRINT}" >&2; exit 1; \
    fi \
    && gpg --batch --dearmor -o /usr/share/keyrings/microsoft.gpg /tmp/microsoft.asc \
    && rm -rf /tmp/microsoft.asc /tmp/microsoft.keys "${GNUPGHOME}" \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/azure-cli/ bookworm main" \
        > /etc/apt/sources.list.d/azure-cli.list \
    && apt-get update \
    && apt-get install --yes --no-install-recommends azure-cli \
    && rm -rf /var/lib/apt/lists/*

# azure-cli bundles its own Python under /opt/az (3.14 as of 2.91.0), and its
# releases lag the libraries inside it: 2.90.0 and 2.91.0 both ship PyJWT
# 2.13.0 (a CRITICAL signature-validation bypass among six), cryptography
# 48.0.1 and urllib3 2.7.0, all fixed upstream. azure-cli-core leaves PyJWT
# and cryptography unpinned and msal allows cryptography<51, so upgrading them
# in place is within what azure-cli declares it supports; pyOpenSSL moves
# with cryptography because older pyOpenSSL caps it.
#
# Exact versions with every wheel's sha256, from az-overrides.txt
# (--require-hashes: pip installs nothing whose hash is not listed there;
# --only-binary: nothing is built from source). They used to be `>=` floors
# fetched fresh from PyPI on every daily rebuild, which put a release into
# the image the day it was published, unhashed -- exactly the window the
# seven-day cooldown exists to avoid. Each is now a pin that
# scripts/check-pins.sh tracks and the pin-bump bot moves once the release is
# seven days old, so a fix still arrives with no hand edit, a week later.
# --no-deps: these replace packages azure-cli already ships, and their own
# dependencies (cffi for cryptography) are in that bundle too. `pip check`
# fails the build if the result ever conflicts with what azure-cli requires,
# and `az version` proves the CLI still starts. pip's own vendored copies
# (pip/_vendor) are not touched -- only a pip release can change those.
COPY az-overrides.txt /tmp/az-overrides.txt
RUN /opt/az/bin/python3 -m pip install --no-cache-dir --disable-pip-version-check \
        --root-user-action=ignore --upgrade \
        --require-hashes --no-deps --only-binary :all: -r /tmp/az-overrides.txt \
    && rm /tmp/az-overrides.txt \
    && /opt/az/bin/python3 -m pip check \
    && az version > /dev/null

# The Google Cloud CLI is a versioned tarball. Google publishes no per-file
# SHA-256 alongside it -- the release bucket carries no .sha256 companions --
# so its sums below are trust-on-first-use, like the Docker static tarball and
# the AWS CLI installer in ci-tools: scripts/bump-pins.sh downloads each
# tarball when it moves the version and records the sha256 of what it got.
# That cannot prove the first download was genuine, but it pins it: a tarball
# substituted later fails every build, the daily rebuilds included, instead
# of being installed. The bump PR then waits seven days from the day it first
# carried that version before it may merge (docs/adr/0008, amendment of
# 2026-10-17). CONTRIBUTING.md records which sums are which.
#
# Google spells arm64 "arm" in its filenames, unlike every other vendor here.
#
# The final `rm -rf` deletes urllib3's test server. gsutil vendors urllib3
# including its test suite, and that suite ships two RSA private keys for its
# dummy HTTPS server. They are published test fixtures rather than live
# credentials -- but they are real private keys, and the secret gate blocks on
# any finding at any severity. That gate is right to fire. Where nothing in a
# CI image could need a fixture, removing it beats excusing it: these two keys
# are not in the published image at all, and nothing in a CI image needs
# urllib3's test server.
#
# The gate now reads every path: Trivy's built-in allow rules, which skip any
# path with `test`, `example` or `/vendor/` in it, site-packages and more,
# are switched off (.github/trivy-secret.yaml; the Secret gate step in
# .github/workflows/build-image.yml has the list). These two keys were caught
# before that only because .../urllib3/dummyserver/ matched none of those
# rules. With them off, the gate also sees the rest of what gsutil vendors:
# the test suites of google-auth-library-python and requests, and gsutil's
# and its vendored boto's own -- keys and fake service accounts generated for
# those projects' unit tests. Those are left in place and excused one by one
# (rule ID and exact path) in .github/trivy-secret-ignore.yaml, because they
# sit inside packages gsutil imports, where deleting test directories would
# be an untested change to gsutil. The dummyserver keys stay deleted: an
# unused test server is the clearer case, and a key that is not in the image
# needs no exception. A future SDK that bundles new fixtures fails the gate
# until each one is deleted here or reviewed into that file.
ARG TARGETARCH
ARG GCLOUD_VERSION=589.0.0
ARG GCLOUD_SHA256_AMD64=f865da648f6fdae2015abb5b32eaa0eb10520e88f0ca735cfb33795868c8d26f
ARG GCLOUD_SHA256_ARM64=3febb61a57ea76612973e40a2ff7bd79939161451d11130659d5c981201dca97
RUN case "${TARGETARCH}" in \
        amd64) gcarch=x86_64 sum="${GCLOUD_SHA256_AMD64}" ;; \
        arm64) gcarch=arm sum="${GCLOUD_SHA256_ARM64}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 300 -o /tmp/gcloud.tgz \
        "https://storage.googleapis.com/cloud-sdk-release/google-cloud-cli-${GCLOUD_VERSION}-linux-${gcarch}.tar.gz" \
    && echo "${sum}  /tmp/gcloud.tgz" > /tmp/gcloud.sum \
    && sha256sum --check --strict /tmp/gcloud.sum \
    && rm /tmp/gcloud.sum \
    && tar -xzf /tmp/gcloud.tgz -C /opt \
    && rm /tmp/gcloud.tgz \
    && /opt/google-cloud-sdk/install.sh \
        --quiet \
        --usage-reporting=false \
        --path-update=false \
        --command-completion=false \
    && rm -rf /opt/google-cloud-sdk/.install/.backup \
    && rm -rf /opt/google-cloud-sdk/platform/gsutil/third_party/urllib3/dummyserver \
    && rm -rf /opt/google-cloud-sdk/platform/bundledpythonunix

# kubectl is shared with ci-tools and pinned to the same version and checksums,
# so a cluster deploy behaves identically whichever of the two images runs it.
# The vendor publishes a per-artifact SHA-256, so this one is verified.
ARG KUBECTL_VERSION=1.37.1
ARG KUBECTL_SHA256_AMD64=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
ARG KUBECTL_SHA256_ARM64=ff749f4b78d9c4f1ec87307df9b50119ed819e2094aa9810cb9acffc3286c8c7
RUN case "${TARGETARCH}" in \
        amd64) sum="${KUBECTL_SHA256_AMD64}" ;; \
        arm64) sum="${KUBECTL_SHA256_ARM64}" ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL --retry 3 --retry-all-errors --max-time 180 \
        -o /usr/local/bin/kubectl \
        "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
    && echo "${sum}  /usr/local/bin/kubectl" > /tmp/kubectl.sum \
    && sha256sum --check --strict /tmp/kubectl.sum \
    && rm /tmp/kubectl.sum \
    && chmod +x /usr/local/bin/kubectl

WORKDIR /workspace

RUN gcloud version \
    && az version \
    && kubectl version --client \
    && git --version

# GitHub Actions supplies commands dynamically.
# Do not define ENTRYPOINT or CMD.
